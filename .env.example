APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
# When true (default in local), URLs are built from the incoming request host.
# Use with ngrok so QR codes, /storage images, and API responses work without
# changing APP_URL every time the tunnel URL changes.
# Local only (ngrok/LAN testing). Keep false in production.
DYNAMIC_APP_URL=false
# Production: pin generated links to APP_URL instead of the request host.
FORCE_APP_URL=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Optional: a full connection URL overrides the DB_* values below.
# In production on Heroku, JAWSDB_URL is set by the add-on and read automatically.
# Never commit a real connection string or password.
# DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=resqnet_db
DB_USERNAME=resqnet_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
# Realtime dashboards (Laravel Reverb). Set BROADCAST_CONNECTION=reverb to enable.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
# Disk for pet images and logos (registration documents always use the private disk)
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Super admin created by `php artisan db:seed`. ADMIN_PASSWORD is required outside local/testing.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mobile API token lifetime in minutes (default 30 days)
SANCTUM_TOKEN_EXPIRATION=43200
# Comma-separated allowed origins for /api; '*' is fine for a token-only API
CORS_ALLOWED_ORIGINS=*

# Firebase service-account JSON for push notifications (never commit the file)
FCM_CREDENTIALS_PATH=storage/app/firebase-auth.json

KHALTI_SECRET_KEY=
KHALTI_SANDBOX=true
KHALTI_WEBSITE_URL=${APP_URL}

VITE_APP_NAME="${APP_NAME}"
