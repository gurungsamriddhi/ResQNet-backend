        },
        {
          "name": "Get Pet by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/pets/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pets", "1"]
            }
          }
        },
        {
          "name": "Get Pet by QR Code",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/pets/qr/SOME_QR_ID",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pets", "qr", "SOME_QR_ID"]
            }
          }
        }
      ]
    },
