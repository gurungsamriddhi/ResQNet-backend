              "raw": "{\n  \"living_situation\": \"House with yard\",\n  \"has_other_pets\": true,\n  \"experience_with_pets\": true,\n  \"family_members_count\": 4,\n  \"housing_type\": \"own\",\n  \"employment_status\": \"Full-time\"\n}"
